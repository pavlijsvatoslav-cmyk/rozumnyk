{
  "name": "rozumnyk",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-site.mjs",
    "dev:vite": "node scripts/export-content.mjs && vite --configLoader native --host 127.0.0.1",
    "export:content": "node scripts/export-content.mjs",
    "build": "node scripts/build-site.mjs",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "wrangler": "^4.47.0"
  }
}
